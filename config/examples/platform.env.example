# Core services
APP_ENV=dev
BRAND_KEY=sell_systems

# Postgres
DATABASE_URL=
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=tg_ops
PGUSER=tg_ops
PGPASSWORD=change-me

# Qdrant
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_DECISION_COLLECTION=decision_cards
QDRANT_CONTENT_COLLECTION=content_cards
QDRANT_OPERATOR_COLLECTION=operator_memory
QDRANT_VECTOR_NAME=dense_main

# Embeddings / rerank
EMBED_PROVIDER=tei
EMBED_BASE_URL=http://127.0.0.1:8080
TEI_EMBED_ENDPOINT=/embed
EMBED_PROFILE=dense-main-v1
# Optional TEI tuning for a memory-constrained CPU node
# TOKENIZATION_WORKERS=2
# MAX_CONCURRENT_REQUESTS=16
# MAX_BATCH_TOKENS=2048
# MAX_BATCH_REQUESTS=2
# MAX_CLIENT_BATCH_SIZE=4
RERANK_ENABLED=0
RERANK_BASE_URL=http://127.0.0.1:8090
RERANK_PROFILE=rerank-main-v1

# Artifacts
ARTIFACTS_ROOT=./artifacts
MEDIA_POSTER_TIME_SECONDS=1.0
LOG_LEVEL=info

# Judge
JUDGE_ENGINE=codex-exec
JUDGE_MODEL=local-policy-judge

# Future content subsystem
CONTENT_GENERATION_ENABLED=0
CONTENT_LANGUAGE_DEFAULT=en
