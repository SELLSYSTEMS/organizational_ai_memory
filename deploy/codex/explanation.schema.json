{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 120 },
          "action": { "type": "string", "minLength": 1, "maxLength": 400 },
          "asset_keys": {
            "type": "array",
            "minItems": 1,
            "maxItems": 9,
            "items": {
              "type": "string",
              "pattern": "^(prompt|workflow|agent|decision|practice):[a-z0-9][a-z0-9_]*$"
            }
          },
          "source_turn_ids": {
            "type": "array",
            "maxItems": 12,
            "items": { "type": "string", "pattern": "^st-[a-z0-9][a-z0-9-]*$" }
          },
          "requires_human_review": { "type": "boolean" }
        },
        "required": ["title", "action", "asset_keys", "source_turn_ids", "requires_human_review"]
      }
    },
    "missing_context": {
      "type": "array",
      "maxItems": 4,
      "items": { "type": "string", "minLength": 1, "maxLength": 400 }
    },
    "limitations": {
      "type": "array",
      "maxItems": 4,
      "items": { "type": "string", "minLength": 1, "maxLength": 400 }
    }
  },
  "required": ["summary", "steps", "missing_context", "limitations"]
}
