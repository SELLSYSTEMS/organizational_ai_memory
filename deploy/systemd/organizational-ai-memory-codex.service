[Unit]
Description=Organizational AI Memory Codex Spark adaptation sidecar
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=oam-codex
Group=oam-codex
WorkingDirectory=/opt/organizational-ai-memory-codex
Environment=NODE_ENV=production
Environment=HOME=/var/lib/oam-codex
Environment=CODEX_HOME=/var/lib/oam-codex/.codex
Environment=OAM_CODEX_SOCKET_PATH=/run/organizational-ai-memory-codex/assist.sock
Environment=OAM_CODEX_WORKSPACE=/var/empty/oam-codex
Environment=OAM_CODEX_SCHEMA_PATH=/opt/organizational-ai-memory-codex/deploy/codex/explanation.schema.json
Environment=OAM_CODEX_TIMEOUT_MS=7000
Environment=OAM_CODEX_GLOBAL_GENERATIONS_PER_MINUTE=12
ExecStart=/usr/bin/node app/codex-sidecar.mjs
Restart=on-failure
RestartSec=3s
RuntimeDirectory=organizational-ai-memory-codex
RuntimeDirectoryMode=0750
StateDirectory=oam-codex
StateDirectoryMode=0700
TimeoutStartSec=10s
TimeoutStopSec=10s
UMask=0007

AmbientCapabilities=
CapabilityBoundingSet=
LockPersonality=true
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
