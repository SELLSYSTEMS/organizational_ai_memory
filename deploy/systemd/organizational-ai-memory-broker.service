[Unit]
Description=Organizational AI Memory governed agent broker
After=network.target postgresql.service

[Service]
Type=simple
User=oam-broker
Group=oam-agent-broker
SupplementaryGroups=oam-broker
WorkingDirectory=/opt/organizational-ai-memory-broker
Environment=NODE_ENV=production
Environment=OAM_BROKER_SOCKET=/run/organizational-ai-memory-broker/agent.sock
EnvironmentFile=/etc/organizational-ai-memory/broker-db.env
ExecStart=/usr/bin/node app/memory-broker.mjs
Restart=on-failure
RestartSec=3s
RuntimeDirectory=organizational-ai-memory-broker
RuntimeDirectoryMode=0750
TimeoutStartSec=15s
TimeoutStopSec=10s
UMask=0007

AmbientCapabilities=
CapabilityBoundingSet=
IPAddressDeny=any
IPAddressAllow=localhost
LockPersonality=true
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProtectSystem=strict
ProcSubset=pid
InaccessiblePaths=/etc/tg_ops /etc/organizational-ai-memory/public-db.env /etc/organizational-ai-memory/operator-db.env /etc/organizational-ai-memory/operator-credentials.json
InaccessiblePaths=/var/lib/oam-codex /var/lib/organizational-ai-memory-operator /var/lib/organizational-ai-memory-quarantine /var/lib/oam-agents /etc/oam-agents
ReadOnlyPaths=/opt/organizational-ai-memory-broker
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
TasksMax=48
MemoryMax=256M
MemorySwapMax=0
LimitNOFILE=256

[Install]
WantedBy=multi-user.target
