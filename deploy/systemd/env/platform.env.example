APP_ROOT=/path/to/repo

APP_DATA_ROOT=/var/lib/tg_ops
APP_CACHE_ROOT=/var/cache/tg_ops
APP_LOG_ROOT=/var/log/tg_ops
APP_ETC_ROOT=/etc/tg_ops

QDRANT_BIN=/usr/local/bin/qdrant
QDRANT_CONFIG=/etc/tg_ops/qdrant.yaml
QDRANT_STORAGE_DIR=/var/lib/tg_ops/qdrant/storage
QDRANT_SNAPSHOTS_DIR=/var/lib/tg_ops/qdrant/snapshots

TEI_BIN=/usr/local/bin/text-embeddings-router
TEI_MODEL_ID=Qwen/Qwen3-Embedding-0.6B
TEI_HOST=127.0.0.1
TEI_PORT=8080
HF_HOME=/var/cache/tg_ops/huggingface
HF_TOKEN=
#
# Optional TEI tuning for a memory-constrained CPU node
# TOKENIZATION_WORKERS=2
# MAX_CONCURRENT_REQUESTS=16
# MAX_BATCH_TOKENS=2048
# MAX_BATCH_REQUESTS=2
# MAX_CLIENT_BATCH_SIZE=4

PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=tg_ops
PGUSER=tg_ops
PGPASSWORD=change-me

QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_VECTOR_NAME=dense_main

LOG_LEVEL=info
