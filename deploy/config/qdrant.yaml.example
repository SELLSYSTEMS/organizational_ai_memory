log_level: INFO

storage:
  storage_path: /var/lib/tg_ops/qdrant/storage
  snapshots_path: /var/lib/tg_ops/qdrant/snapshots
  temp_path: /var/lib/tg_ops/qdrant/tmp
  on_disk_payload: true

service:
  host: 127.0.0.1
  http_port: 6333
  grpc_port: 6334
  enable_cors: false

cluster:
  enabled: false
